; Engine configuration file.
; Godot 4.x — open this folder in the editor (Import / Import Existing Project).
config_version=5

[application]

config/name="Coin Master 2D"
config/description="街机投币机 / arcade coin-tosser"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"
run/max_fps=60

[autoload]

GameState="*res://autoload/game_state.gd"
InputRouter="*res://autoload/input_router.gd"
PlatformManager="*res://autoload/platform_manager.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input]

