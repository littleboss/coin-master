[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[layer_names]

2d_physics/layer_1="coins"
2d_physics/layer_2="world"
2d_physics/layer_3="slots"

[physics]

2d/default_gravity=980.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.0509804, 0.054902, 0.0823529, 1)
